# Copy to backend/.env and fill in. Real environment variables override this file.

# From @BotFather (/newbot). Leave empty to run without the Telegram bot.
TELEGRAM_BOT_TOKEN=

# Your numeric chat id (message @userinfobot). Strongly recommended: when set,
# the bot ignores every other chat. Unset = any chat can drive your board.
TELEGRAM_ALLOWED_CHAT_ID=

# Password for the web UI, /api and /ws (HTTP Basic, any username; browsers then get a session cookie).
# Unset = open. ALWAYS set this when the server is reachable from the internet.
BOARD_PASSWORD=

# MCP server (POST /mcp). When set, clients must send "Authorization: Bearer <key>".
# Unset = no auth, but only localhost connections are accepted.
MCP_API_KEY=

# Optional
# PORT=3001
# BOARD_DB=board.db
# BOARD_TITLE=Ship Board
# STATIC_DIR=../frontend/dist                 # serve the built frontend from the backend
# TELEGRAM_API_URL=https://api.telegram.org   # override for a self-hosted Bot API server or tests
